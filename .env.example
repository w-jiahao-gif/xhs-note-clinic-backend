# ===== 计费模式 =====
# mock  = 本地沙箱（不产生真实扣款，用于联调测试）
# alipay= 支付宝 AI 按量付费（真实收款，需完成下方全部配置）
BILLING_MODE=mock

# ===== 通用 =====
PORT=8787
# 单次体检价格，单位：分。199 = ¥1.99（mock 模式默认 1 = ¥0.01）
PRICE_FEN=199
ORDERS_FILE=./data/orders.json

# ===== 支付宝 AI 按量付费（BILLING_MODE=alipay 时必填）=====
# 开放平台自研应用 AppId（opendocs.alipay.com → 控制台 → 应用列表）
ALIPAY_APP_ID=
# 应用私钥（密钥工具生成，PKCS8，可用 \n 转义换行）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（非应用公钥！用于验签网关响应）
ALIPAY_PUBLIC_KEY=
# 收款方支付宝 userId（2088 开头）
ALIPAY_SELLER_ID=
# 服务 ID（支付宝 AI 付控制台注册服务后获得，API_ 开头，详见 ideservice.alipay.com FAQ Q2）
ALIPAY_SERVICE_ID=
# 网关（默认正式环境）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 展示给买家的收款方名称
SELLER_NAME=笔记体检站
